rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /videos/{id} {
      // Читать можно опубликованные видео и свои собственные
      allow read: if resource.data.published == true
                  || (request.auth != null && resource.data.uid == request.auth.uid);
      // Владелец может менять ТОЛЬКО флаг published (публикация / снятие)
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['published']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      // Создаёт документы только сервер (Admin SDK обходит правила)
      allow create: if false;
    }

    // Аккаунты: каждый видит и меняет только свой документ
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['email', 'phone', 'createdAt']);
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'phone']);
      allow delete: if false;
    }
  }
}
{
  "rules": {
    ".read": false,
    ".write": false
  }
}